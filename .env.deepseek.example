# Chat: DeepSeek official API. OPENAI is the protocol name, not the provider.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
MODEL_ROUTING_ENABLED=false

# Embeddings: Bailian Beijing endpoint, with its own region-matched API Key.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10

KNOWLEDGE_DIR=data/knowledge
QDRANT_PATH=.data/qdrant-bailian-v4
QDRANT_URL=
QDRANT_COLLECTION=support_knowledge_bailian_v4
SUPPORT_DB_PATH=.data/support.db

MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
TOP_K=5
MAX_CITATIONS=2
RELEVANCE_RATIO=0.6
MAX_UPLOAD_MB=10
