# Beijing region: use a Bailian API Key created in the same region.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
MODEL_ROUTING_ENABLED=false

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10

KNOWLEDGE_DIR=data/knowledge
# Separate from the old Hash index; changing embedding models requires reindexing.
QDRANT_PATH=.data/qdrant-bailian-v4
QDRANT_URL=
QDRANT_COLLECTION=support_knowledge_bailian_v4
SUPPORT_DB_PATH=.data/support.db

MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
TOP_K=5
MAX_CITATIONS=2
RELEVANCE_RATIO=0.6
MAX_UPLOAD_MB=10
