# offline: no API key required; openai: use an OpenAI-compatible chat endpoint
MODEL_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4.1-mini
MODEL_ROUTING_ENABLED=false

# hash is deterministic and offline; openai gives higher quality semantic retrieval
EMBEDDING_PROVIDER=hash
# Leave BOTH blank to share the chat endpoint/key. Otherwise fill BOTH.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=10
HASH_EMBEDDING_DIMENSIONS=384

KNOWLEDGE_DIR=data/knowledge
QDRANT_PATH=.data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=support_knowledge
SUPPORT_DB_PATH=.data/support.db

MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
TOP_K=5
MAX_CITATIONS=2
RELEVANCE_RATIO=0.6
MAX_UPLOAD_MB=10
